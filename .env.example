# Copy to .env and fill in. Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com
DJANGO_TIME_ZONE=UTC
PORTAL_BASE_URL=https://portal.example.com

POSTGRES_HOST=db
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=servicedesk@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM=IT Service Desk <servicedesk@example.com>

# Microsoft 365 (Graph application permissions, least privilege; see README)
M365_MODE=dry_run
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_DEFAULT_LICENSE_SKU_ID=

# n8n (outbound webhooks are signed with N8N_WEBHOOK_SECRET; inbound callbacks with N8N_INBOUND_SECRET)
N8N_WEBHOOK_SECRET=change-me-long-random
N8N_INBOUND_SECRET=change-me-different-long-random
N8N_ACTOR_USERNAME=n8n-service
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/
PORTAL_APPROVER_EMAIL=
